# ---- Django ----
DJANGO_SECRET_KEY=ganti-dengan-string-acak-panjang
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Isi jika dipasang di belakang HTTPS/domain, contoh: https://siaga.example.go.id
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---- PostgreSQL ----
POSTGRES_DB=siaga_karhutla
POSTGRES_USER=siaga
POSTGRES_PASSWORD=siaga
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Aplikasi ----
# 1 = dashboard/matriks/peta bisa dibuka tanpa login (input tetap wajib login)
SIAGA_PUBLIC_READ=0

# ---- SIPONGI ----
SIPONGI_API_URL=https://opsroom.sipongidata.my.id/api/opsroom/indoHotspot
SIPONGI_TIMEOUT=60
# Confidence yang disimpan ke database (low tidak disimpan agar DB ringan)
HOTSPOT_STORE_CONFIDENCE=high,medium

# Aktifkan (=1) bila berjalan di belakang HTTPS (cookie aman, redirect SSL, HSTS)
DJANGO_SECURE=0
